NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
FRONTEND_ORIGIN=http://localhost:5173
# Railway sets RAILWAY_* variables automatically. In production, also set
# FRONTEND_ORIGIN to the deployed frontend origin exactly.
SESSION_COOKIE_NAME=reddit_session
SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PROFILE_READ_RATE_LIMIT=120
PROFILE_READ_RATE_WINDOW_SECONDS=60
